#!/usr/bin/env bash
set -euo pipefail

# Refresh the user-level plugin-root pointer (used by the opt-in status
# line, installed globally in ~/.claude/settings.json) so it survives
# plugin version upgrades that change the versioned install path.
PLUGIN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p "$HOME/.claude/afyapowers-core" 2>/dev/null || true
printf '%s\n' "$PLUGIN_ROOT" > "$HOME/.claude/afyapowers-core/plugin-root" 2>/dev/null || true

# Warn the model if Python 3 is unavailable — every other hook of this plugin
# and the status line are Python. SessionStart cannot block, so this is a
# non-blocking warning only. SessionStart context must go under
# hookSpecificOutput: a top-level `additionalContext` is silently dropped.
if ! command -v python3 >/dev/null 2>&1; then
  echo '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "⚠️ Python 3 not found on PATH — afyapowers-core hooks (Jira ticket, telemetry, language directive, history) and the status line will not work. Install Python 3.9+."}}'
  exit 0
fi

echo '{}'
