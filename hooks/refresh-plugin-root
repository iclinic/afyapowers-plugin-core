#!/usr/bin/env bash
set -euo pipefail

# Refresh the user-level plugin-root pointer (used by the opt-in status
# line, installed globally in ~/.claude/settings.json) so it survives
# plugin version upgrades that change the versioned install path.
PLUGIN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p "$HOME/.claude/afyapowers-core" 2>/dev/null || true
printf '%s\n' "$PLUGIN_ROOT" > "$HOME/.claude/afyapowers-core/plugin-root" 2>/dev/null || true

# Warn if Python 3 is unavailable — every other hook of this plugin
# (lang-directive, render-history, otel-context) and the status line are
# Python. SessionStart cannot block, so this is a non-blocking warning only.
if ! command -v python3 >/dev/null 2>&1; then
  echo '{"additionalContext": "⚠️ Python 3 not found on PATH — afyapowers-core hooks (language directive, history logging, telemetry) and the status line will not work. Install Python 3.9+."}'
  exit 0
fi

echo '{}'
