#!/usr/bin/env python3
"""afyapowers language directive injector.

Injects the pt-BR language directive whenever an afyapowers skill is invoked,
close to the action — skills may carry English message templates — without the
per-turn token cost of firing on every prompt. The core injects it nowhere else.

Two Claude Code events surface a skill invocation:

  - PreToolUse on the `Skill` tool: matches when `tool_input.skill` starts with
    `afyapowers*:` — any afyapowers-family plugin — for model-invoked skills.
  - UserPromptExpansion: matches when `command_name` starts with
    `afyapowers*:`, for user-typed `/afyapowers...:...` commands.

Contract: augmentation only. Must NEVER block. On no-match, bad input, or any
error -> exit 0 with no output.
"""

import sys
import json
import re

# Skills/commands of any afyapowers-family plugin: `afyapowers:...`,
# `afyapowers-core:...`, and future `afyapowers-*` packages.
AFYA_PREFIX_RE = re.compile(r"^afyapowers[^:]*:")

# The directive text. Technical/product terms and workflow phase identifiers stay
# in English; code/identifiers/paths are never translated.
DIRECTIVE = (
    "Idioma / Language: Fale com o usuário em português do Brasil (pt-BR) por padrão. "
    "Se o usuário escrever em outro idioma, espelhe o idioma dele na conversa. "
    "Ao executar qualquer skill do afyapowers (new, next, design, plan, implement, "
    "review, complete, status, switch, etc.), TRADUZA para pt-BR toda mensagem "
    "destinada ao usuário antes de exibi-la — os templates de mensagem em inglês "
    "dentro das skills são apenas guias de conteúdo, não o texto final. TODOS os "
    "artefatos do afyapowers (design.md, plan.md, review.md, completion.md, "
    "implementation-concerns.md e docs) DEVEM ser escritos SEMPRE em português do "
    "Brasil, seguindo estritamente os templates. Mantenha em inglês os termos "
    "técnicos/de produto convencionalmente em inglês (ex.: Tech Stack, endpoint, "
    "deploy, payload, breakpoint, Node Map, PR, merge, changelog) e os "
    "identificadores de fase do workflow (design, plan, implement, review, "
    "complete); nunca traduza código, identificadores ou caminhos de arquivo."
)


def emit_context(event_name):
    """Emit the directive as structured additional context for a tool-use event."""
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": event_name,
            "additionalContext": DIRECTIVE,
        }
    }))


def main():
    raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except Exception:
        return
    if not isinstance(data, dict):
        return

    # Model-invoked skill via the Skill tool (PreToolUse).
    if data.get("tool_name") == "Skill":
        tool_input = data.get("tool_input")
        skill = str(tool_input.get("skill", "")) if isinstance(tool_input, dict) else ""
        if AFYA_PREFIX_RE.match(skill):
            emit_context("PreToolUse")
        return
    # User-typed slash command (UserPromptExpansion).
    command_name = data.get("command_name")
    if command_name and AFYA_PREFIX_RE.match(str(command_name)):
        emit_context("UserPromptExpansion")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        # Never block a session.
        pass
