#!/usr/bin/env python3
"""afyapowers-core OTLP context emitter.

Enriches Claude Code's OpenTelemetry data with the per-session context that the
native telemetry cannot carry: the session's Jira ticket, git repo/branch/commit,
the host name and the active afyapowers-dev phase. Anything the native events
already carry for the same `session.id` is left to them — user.email on every
event, plugin names and versions on `plugin_loaded`.

`env` in settings.json is strictly static (no interpolation, no command
substitution) and no hook can export env vars back into the Claude Code
process, so values like the current git branch can never reach
`OTEL_RESOURCE_ATTRIBUTES`. Instead this hook emits its own OTLP log records to
the same collector, tagged with `session.id` and `prompt.id` — the standard
attributes on every native `claude_code.*` event — so the backend can join them.

When it sends: once the session's ticket is known — the ticket hook
calls this one right after recording an answer (a key or "no ticket"), and the
first prompt of a resumed session that already has one also counts — and then
only when the repo or the branch changes. Prompts with no change send nothing;
there is no send at SessionStart or SessionEnd. The last state that reached the
collector is kept in the session folder (`context-sent.json`) and is written only
on a 2xx, so a failed send is retried on the next prompt instead of leaving a
healthy session looking mute.

Two modes, so nothing on the prompt's critical path touches git or the network:

  (default)  Hook entrypoint. Leaves at once while the session has no ticket
             yet; otherwise resolves config and spawns a detached child with
             {config, payload} on stdin. Returns immediately.
  --emit     The detached child. Collects git attributes, decides whether this
             is a first send or a repo/branch change, encodes the OTLP payload,
             POSTs it, exits silently.

Speaks both `http/protobuf` (the OTel default, and what collectors that reject
JSON require) and `http/json`, selected from AFYAPOWERS_OTLP_LOGS_PROTOCOL.
The protobuf encoder is hand-rolled because the plugin is stdlib-only.

Contract: this is observability only. It must NEVER block a session or crash a
host. Any error -> exit 0. It must also NEVER write to stdout: on
`UserPromptSubmit` a hook's stdout is injected as context into the user's prompt.

Every attempt, including one with no destination, overwrites
`<config>/afyapowers-core/last-send.json` with its time, endpoint, HTTP status,
error and the time of the last successful send — the file to read when a
machine looks mute, since failures are otherwise invisible. Only the last
attempt is kept.
"""

import json
import os
import socket
import struct
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

sys.dont_write_bytecode = True  # no __pycache__ inside the installed plugin
try:
    import session_store as store  # hooks/session_store.py: paths + ticket format
except Exception:
    sys.exit(0)  # a broken module ends the hook in silence, like any other error

GIT_TIMEOUT = 5
HTTP_TIMEOUT = 5
SCOPE_NAME = "afyapowers-core"
EVENT_NAME = "afyapowers-core.session_context"
DEFAULT_SERVICE_NAME = "afyapowers-core"
DEFAULT_PROTOCOL = "http/protobuf"  # matches the OTel spec default
SEVERITY_INFO = 9  # SEVERITY_NUMBER_INFO

# Explicit null for an attribute: encoded as an empty AnyValue (ValueTypeEmpty
# on the collector side), unlike None/"" which drop the attribute entirely.
ATTR_NULL = object()
# Explicit empty string for an attribute: sent as string_value "" (set, but
# empty), unlike None/"" which drop the attribute entirely.
ATTR_EMPTY = object()


# --------------------------------------------------------------------------- #
# Config resolution
# --------------------------------------------------------------------------- #

def parse_kv(raw):
    """Parse an OTel `k=v,k=v` list. Values are percent-decoded per spec."""
    out = {}
    if not raw:
        return out
    for item in raw.split(","):
        if "=" not in item:
            continue
        key, _, value = item.partition("=")
        key = key.strip()
        if not key:
            continue
        out[key] = urllib.parse.unquote(value.strip())
    return out


def resolve_config(payload):
    """Build the emitter config, or return (None, reason) when there is nowhere
    to send to.

    The destination comes ONLY from our own variables, which the organization
    sets in the `env` block of the Claude Code policy next to the OTEL_* ones:

      AFYAPOWERS_OTLP_LOGS_ENDPOINT  the full OTLP logs URL, used as is
      AFYAPOWERS_OTLP_LOGS_HEADERS   `k=v,k=v`, percent-decoded per OTel spec
      AFYAPOWERS_OTLP_LOGS_PROTOCOL  http/protobuf (default) or http/json

    Claude Code strips OTEL_* from hook subprocesses but passes these through,
    already resolved with its own precedence (the policy wins over user and
    project settings), so the process environment is the single source: no
    settings files, no `remote-settings.json` cache, no OTEL_*.
    For a local test, the same variables in user or project settings work.

    Where there is no policy (Cowork, or a machine that never received it) the
    variables are absent and the hook stays silent: no send, no output, no error.
    """
    cwd = payload.get("cwd") or os.getcwd()

    def get(name):
        return os.environ.get(name) or None

    endpoint = get("AFYAPOWERS_OTLP_LOGS_ENDPOINT")
    if not endpoint:
        return None, "no AFYAPOWERS_OTLP_LOGS_ENDPOINT"

    protocol = get("AFYAPOWERS_OTLP_LOGS_PROTOCOL") or DEFAULT_PROTOCOL
    if protocol == "grpc":
        # We only speak OTLP over HTTP.
        return None, "grpc protocol unsupported; use http/protobuf or http/json"

    # The headers may pin a content-type for the native exporter's encoding;
    # ours is decided by `protocol`, so drop any copy.
    headers = {
        k: v
        for k, v in parse_kv(get("AFYAPOWERS_OTLP_LOGS_HEADERS")).items()
        if k.lower() != "content-type"
    }

    return {
        "endpoint": endpoint,
        "protocol": protocol,
        "headers": headers,
        "resource": {"service.name": DEFAULT_SERVICE_NAME},
        "cwd": cwd,
    }, None


# --------------------------------------------------------------------------- #
# Last-send record
# --------------------------------------------------------------------------- #

LAST_SEND_FILE = "last-send.json"


def record_send(endpoint, status, error):
    """Overwrite last-send.json with this attempt. `last_success` carries over
    from the previous record unless this attempt got a 2xx. Written whole to a
    temp file and swapped in, so a reader never sees half a record. Best effort:
    any failure is swallowed — the record must never break the hook."""
    try:
        state = store.state_dir()
        if state is None:
            return
        path = state / LAST_SEND_FILE
        now = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        last_success = None
        try:
            last_success = json.loads(path.read_text(encoding="utf-8")).get("last_success")
        except Exception:
            pass
        if isinstance(status, int) and 200 <= status < 300:
            last_success = now
        record = {
            "ts": now,
            "endpoint": endpoint,
            "status": status,
            "error": error,
            "last_success": last_success,
        }
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name("{}.{}.tmp".format(path.name, os.getpid()))
        tmp.write_text(json.dumps(record, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        os.replace(tmp, path)
    except Exception:
        pass


# --------------------------------------------------------------------------- #
# Send state (child only, per session)
# --------------------------------------------------------------------------- #

SENT_STATE_FILE = "context-sent.json"   # repo/branch last confirmed by the collector


def _plain(value):
    return None if value is ATTR_NULL else value


def needs_send(state_path, repo, branch):
    """First send of the session (no state yet) or a repo/branch change."""
    try:
        prev = json.loads(state_path.read_text(encoding="utf-8"))
    except Exception:
        return True
    return prev.get("repo") != repo or prev.get("branch") != branch


def save_sent_state(state_path, repo, branch):
    try:
        tmp = state_path.with_name("{}.{}.tmp".format(state_path.name, os.getpid()))
        tmp.write_text(json.dumps({"repo": repo, "branch": branch}), encoding="utf-8")
        os.replace(tmp, state_path)
    except Exception:
        pass


# --------------------------------------------------------------------------- #
# Active feature phase (child only)
# --------------------------------------------------------------------------- #

def feature_phase(cwd):
    """Current workflow phase of the active afyapowers-dev feature.

    Optional by design: a missing file, an empty/`null` pointer, an unsafe
    slug or an absent `current_phase:` line all mean the attribute is not
    emitted at all (unlike the fixed attributes, which are always present, as
    a value or an explicit null). state.yaml is read with a line scan instead
    of a YAML parser to stay stdlib-only; anchoring on column 0 skips the
    indented per-phase entries under `phases:`.
    """
    try:
        features = Path(cwd) / ".afyapowers" / "features"
        slug = (features / "active").read_text(encoding="utf-8").strip()
        if not slug or slug.lower() == "null" or Path(slug).name != slug:
            return None
        text = (features / slug / "state.yaml").read_text(encoding="utf-8")
    except Exception:
        return None
    for line in text.splitlines():
        if line.startswith("current_phase:"):
            return line[len("current_phase:"):].strip() or None
    return None


# --------------------------------------------------------------------------- #
# Host identity (child only)
# --------------------------------------------------------------------------- #

def hostname():
    """This machine's network hostname, or None if it cannot be determined."""
    try:
        return socket.gethostname() or None
    except Exception:
        return None


# --------------------------------------------------------------------------- #
# Git attributes (child only)
# --------------------------------------------------------------------------- #

def git(cwd, *args):
    try:
        result = subprocess.run(
            ["git", "-C", cwd, *args],
            capture_output=True,
            text=True,
            timeout=GIT_TIMEOUT,
        )
    except Exception:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


# Path segments that hosting providers inject into clone URLs and that carry no
# identity: Azure DevOps uses `.../_git/<repo>`, Bitbucket Server `.../scm/...`.
REMOTE_NOISE_SEGMENTS = {"_git", "scm"}


def remote_slug(url):
    """Turn a clone URL into an `owner/repo` slug.

    Handles scp-like (`git@host:owner/repo.git`), ssh:// and https:// forms,
    including nested GitLab groups and Azure DevOps `_git` paths. Only the path
    is ever used, never the authority — a clone URL can embed credentials
    (`https://user:token@host/...`) and those must not reach telemetry.

    Returns None for a remote that is a local filesystem path: it identifies
    nothing outside the machine it came from, and shipping it would leak the
    developer's directory layout into telemetry.
    """
    if not url:
        return None
    url = url.strip()

    if "://" in url:
        path = urllib.parse.urlsplit(url).path
    else:
        host, sep, rest = url.partition(":")
        # scp-like syntax needs a colon with no slash before it, over a host of
        # more than one character — a single letter is a Windows drive.
        if not sep or "/" in host or len(host) < 2:
            return None
        path = rest

    if path.endswith(".git"):
        path = path[: -len(".git")]

    segments = [
        seg for seg in path.split("/") if seg and seg not in REMOTE_NOISE_SEGMENTS
    ]
    return "/".join(segments) or None


def git_remote_url(cwd):
    """Clone URL of `origin`, or of the first remote when there is no `origin`."""
    url = git(cwd, "remote", "get-url", "origin")
    if url:
        return url
    remotes = git(cwd, "remote")
    if not remotes:
        return None
    return git(cwd, "remote", "get-url", remotes.splitlines()[0].strip())


# Every git attribute this hook can carry. The record always has all of them,
# as a value or as an explicit null, so the backend sees one stable schema.
GIT_ATTR_KEYS = ("git.repo", "git.branch", "git.commit")


def git_attrs(cwd):
    """Collect git context. Never returns None.

    Whatever cannot be resolved — no repo at all, no commits yet — comes back
    as ATTR_NULL rather than being left out, because a missing attribute and a
    null one are different facts to a query, and an unenrichable session must
    still produce a record.

    Separate calls on purpose: `git rev-parse` flags are sticky, so combining
    --abbrev-ref/--short/--show-toplevel returns values in an unpredictable
    order. This runs in the detached child, so the extra forks are free.
    """
    attrs = dict.fromkeys(GIT_ATTR_KEYS, ATTR_NULL)

    toplevel = git(cwd, "rev-parse", "--show-toplevel")
    if not toplevel:
        return attrs  # not a git repo — every git attribute stays null

    # Prefer the remote slug: the local folder name is whatever each developer
    # happened to clone into, so it cannot identify a repo across a fleet.
    attrs["git.repo"] = (
        remote_slug(git_remote_url(cwd)) or os.path.basename(toplevel) or ATTR_NULL
    )

    # Empty in detached HEAD, a state worth distinguishing from a branch.
    attrs["git.branch"] = git(cwd, "branch", "--show-current") or "detached"

    # Null in a repo with no commits yet.
    attrs["git.commit"] = git(cwd, "rev-parse", "--short", "HEAD") or ATTR_NULL

    return attrs


# --------------------------------------------------------------------------- #
# OTLP encoding — protobuf
# --------------------------------------------------------------------------- #
# Hand-rolled because the plugin is stdlib-only. Field numbers come from the
# OTLP proto definitions (common/v1/common.proto, resource/v1/resource.proto,
# logs/v1/logs.proto) and must not be renumbered.

def _varint(value):
    out = bytearray()
    while True:
        byte = value & 0x7F
        value >>= 7
        out.append(byte | (0x80 if value else 0))
        if not value:
            return bytes(out)


def _tag(field, wire_type):
    return _varint((field << 3) | wire_type)


def _pb_string(field, text):
    raw = str(text).encode("utf-8")
    return _tag(field, 2) + _varint(len(raw)) + raw


def _pb_message(field, body):
    return _tag(field, 2) + _varint(len(body)) + body


def _pb_varint(field, value):
    return _tag(field, 0) + _varint(value)


def _pb_fixed64(field, value):
    return _tag(field, 1) + struct.pack("<Q", value)


def _pb_key_values(field, mapping):
    """repeated KeyValue { key = 1; AnyValue value = 2 { string_value = 1 } }

    ATTR_NULL encodes as an empty AnyValue (no oneof field set) — the OTLP
    representation of null; ATTR_EMPTY as string_value ""; None/"" drop the
    attribute entirely."""
    out = b""
    for key, value in mapping.items():
        if value is ATTR_NULL:
            any_value = b""
        elif value is ATTR_EMPTY:
            any_value = _pb_string(1, "")
        elif value in (None, ""):
            continue
        else:
            any_value = _pb_string(1, value)
        out += _pb_message(field, _pb_string(1, key) + _pb_message(2, any_value))
    return out


def encode_protobuf(resource, attrs, time_ns):
    # LogRecord: time_unix_nano=1, severity_number=2, severity_text=3, body=5,
    #            attributes=6, observed_time_unix_nano=11
    log_record = (
        _pb_fixed64(1, time_ns)
        + _pb_varint(2, SEVERITY_INFO)
        + _pb_string(3, "INFO")
        + _pb_message(5, _pb_string(1, EVENT_NAME))
        + _pb_key_values(6, attrs)
        + _pb_fixed64(11, time_ns)
    )
    # ScopeLogs: scope=1 (InstrumentationScope { name = 1 }), log_records=2
    scope_logs = _pb_message(1, _pb_string(1, SCOPE_NAME)) + _pb_message(2, log_record)
    # ResourceLogs: resource=1 (Resource { attributes = 1 }), scope_logs=2
    resource_logs = _pb_message(1, _pb_key_values(1, resource)) + _pb_message(2, scope_logs)
    # LogsData: resource_logs=1
    return _pb_message(1, resource_logs)


# --------------------------------------------------------------------------- #
# OTLP encoding — JSON
# --------------------------------------------------------------------------- #

def _json_attributes(mapping):
    """ATTR_NULL encodes as an empty AnyValue ({}) — the OTLP representation
    of null; ATTR_EMPTY as {"stringValue": ""}; None/"" drop the attribute
    entirely."""
    out = []
    for k, v in mapping.items():
        if v is ATTR_NULL:
            out.append({"key": k, "value": {}})
        elif v is ATTR_EMPTY:
            out.append({"key": k, "value": {"stringValue": ""}})
        elif v not in (None, ""):
            out.append({"key": k, "value": {"stringValue": str(v)}})
    return out


def encode_json(resource, attrs, time_ns):
    return json.dumps(
        {
            "resourceLogs": [
                {
                    "resource": {"attributes": _json_attributes(resource)},
                    "scopeLogs": [
                        {
                            "scope": {"name": SCOPE_NAME},
                            "logRecords": [
                                {
                                    "timeUnixNano": str(time_ns),
                                    "observedTimeUnixNano": str(time_ns),
                                    "severityNumber": SEVERITY_INFO,
                                    "severityText": "INFO",
                                    "body": {"stringValue": EVENT_NAME},
                                    "attributes": _json_attributes(attrs),
                                }
                            ],
                        }
                    ],
                }
            ]
        }
    ).encode("utf-8")


# --------------------------------------------------------------------------- #
# Emission (child only)
# --------------------------------------------------------------------------- #

def emit(config, payload):
    """Send one record when it is the session's first send or the repo/branch
    changed since the last confirmed one; otherwise send nothing.

    Every fixed attribute is always present — a real value or an explicit null
    — so a session outside a repo is still visible in the backend. Optional
    attributes (host name, feature phase) are omitted when they have no value.
    """
    cwd = config["cwd"]

    git_info = git_attrs(cwd)
    repo, branch = _plain(git_info.get("git.repo")), _plain(git_info.get("git.branch"))
    sdir = store.session_dir(payload.get("session_id"))
    if sdir is None:
        return
    state_path = sdir / SENT_STATE_FILE
    if not needs_send(state_path, repo, branch):
        return
    # No lock: if the ticket hook's trigger and a prompt land together, the
    # record may go out twice — harmless, the backend counts per session.
    _send(config, payload, git_info, state_path, repo, branch)


def _session_key(session_id):
    """The recorded key, or ATTR_EMPTY for "no ticket" (sent as "")."""
    ticket = store.read_ticket(session_id)
    return ATTR_EMPTY if ticket in (None, store.NO_TICKET) else ticket


def _send(config, payload, git_info, state_path, repo, branch):
    cwd = config["cwd"]

    # session.id / prompt.id are the join keys against the native claude_code.*
    # events — structural, not optional. prompt_id is absent before first input.
    attrs = {
        "event.name": EVENT_NAME,
        "session.id": payload.get("session_id") or ATTR_NULL,
        "prompt.id": payload.get("prompt_id") or ATTR_NULL,
        "hook.event": payload.get("hook_event_name") or ATTR_NULL,
        # The session's answer: the key, or "" for "no ticket". Only sent once
        # the ticket is known, so empty never means "not answered".
        "jira.key": _session_key(payload.get("session_id")),
        **git_info,
    }
    # Optional, OTel host semconv; omitted (never null) when unresolvable.
    host = hostname()
    if host:
        attrs["host.name"] = host
    # Optional workflow context: only present when an afyapowers-dev feature is
    # active and its state.yaml names a phase — never emitted as null.
    phase = feature_phase(cwd)
    if phase:
        attrs["afyapowers_dev.current_phase"] = phase

    time_ns = time.time_ns()
    if config["protocol"] == "http/json":
        body, content_type = encode_json(config["resource"], attrs, time_ns), "application/json"
    else:
        body, content_type = (
            encode_protobuf(config["resource"], attrs, time_ns),
            "application/x-protobuf",
        )

    status, error = None, None
    try:
        # Built inside the try: a malformed endpoint must land in last-send.json.
        request = urllib.request.Request(
            config["endpoint"], data=body, headers={"Content-Type": content_type}
        )
        for key, value in config["headers"].items():
            request.add_header(key, value)
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
            status = response.status
    except urllib.error.HTTPError as exc:  # the collector answered, with an error
        status, error = exc.code, "HTTPError: {}".format(exc.reason)
    except Exception as exc:  # network, TLS, collector down — all silent
        error = "{}: {}".format(type(exc).__name__, exc)
    record_send(config["endpoint"], status, error)
    if isinstance(status, int) and 200 <= status < 300:
        save_sent_state(state_path, repo, branch)  # only what reached the collector


# --------------------------------------------------------------------------- #
# Entrypoints
# --------------------------------------------------------------------------- #

def spawn_detached(blob):
    """Hand the work to a detached child so the hook never blocks the prompt."""
    kwargs = {
        "stdin": subprocess.PIPE,
        "stdout": subprocess.DEVNULL,
        "stderr": subprocess.DEVNULL,
    }
    if os.name == "nt":
        DETACHED_PROCESS = 0x00000008
        CREATE_NEW_PROCESS_GROUP = 0x00000200
        kwargs["creationflags"] = DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    else:
        kwargs["start_new_session"] = True

    child = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--emit"], **kwargs
    )
    child.stdin.write(blob.encode("utf-8"))
    child.stdin.close()  # no wait() — the child outlives us


def run_hook():
    payload = json.loads(sys.stdin.read() or "{}")
    if store.read_ticket(payload.get("session_id")) is None:
        return  # nothing to send before the ticket is known (no attempt, no record)
    config, reason = resolve_config(payload)
    if config is None:
        record_send(None, None, reason)  # no destination: recorded, never shown
        return
    spawn_detached(json.dumps({"config": config, "payload": payload}))


def run_emit():
    blob = json.loads(sys.stdin.read() or "{}")
    config, payload = blob.get("config"), blob.get("payload") or {}
    if not isinstance(config, dict):
        # Invoked directly for testing: resolve config from the environment.
        config, _ = resolve_config(payload)
        if config is None:
            return
    if not config.get("endpoint"):
        return
    config.setdefault("protocol", DEFAULT_PROTOCOL)
    config.setdefault("cwd", payload.get("cwd") or os.getcwd())
    config.setdefault("headers", {})
    config.setdefault("resource", {"service.name": DEFAULT_SERVICE_NAME})
    emit(config, payload)


def main():
    try:
        if "--emit" in sys.argv[1:]:
            run_emit()
        else:
            run_hook()
    except Exception:
        pass  # observability must never break a session
    sys.exit(0)


if __name__ == "__main__":
    main()
