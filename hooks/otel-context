#!/usr/bin/env python3
"""afyapowers-core OTLP context emitter.

Enriches Claude Code's OpenTelemetry data with dynamic per-session git, Jira and
plugin-version context that the native telemetry cannot carry — including the
version of every installed afyapowers-family plugin (afyapowers, afyapowers-core,
afyapowers-design, ...), discovered via `claude plugin list --json` and emitted
as `<name with "-" -> "_">.version` attributes. `env` in settings.json is strictly static (no
interpolation, no command substitution) and no hook can export env vars back into
the Claude Code process, so values like the current git branch can never reach
`OTEL_RESOURCE_ATTRIBUTES`. Instead this hook emits its own OTLP log records to
the same collector, tagged with `session.id` and `prompt.id` — the standard
attributes on every native `claude_code.*` event — so the backend can join them.

Two modes, so nothing on the prompt's critical path touches git or the network:

  (default)  Hook entrypoint. Resolves config, and if telemetry is on, spawns a
             detached child with {config, payload} on stdin. Returns immediately.
  --emit     The detached child. Collects git attributes, encodes the OTLP
             payload, POSTs it, exits silently.

Speaks both `http/protobuf` (the OTel default, and what collectors that reject
JSON require) and `http/json`, selected from OTEL_EXPORTER_OTLP_LOGS_PROTOCOL.
The protobuf encoder is hand-rolled because the plugin is stdlib-only.

Contract: this is observability only. It must NEVER block a session or crash a
host. Any error -> exit 0. It must also NEVER write to stdout: on
`UserPromptSubmit` a hook's stdout is injected as context into the user's prompt.

Set AFYAPOWERS_CORE_OTEL_DEBUG=1 to trace what was sent (or why it wasn't) into
`.afyapowers/otel-debug.jsonl`, since failures are otherwise invisible.
"""

import json
import os
import re
import socket
import struct
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request
from pathlib import Path

GIT_TIMEOUT = 5
HTTP_TIMEOUT = 5
CLI_TIMEOUT = 10
SCOPE_NAME = "afyapowers-core"
EVENT_NAME = "afyapowers-core.git_context"
DEFAULT_SERVICE_NAME = "afyapowers-core"
DEFAULT_PROTOCOL = "http/protobuf"  # matches the OTel spec default
SEVERITY_INFO = 9  # SEVERITY_NUMBER_INFO

# Explicit null for an attribute: encoded as an empty AnyValue (ValueTypeEmpty
# on the collector side), unlike None/"" which drop the attribute entirely.
ATTR_NULL = object()


# --------------------------------------------------------------------------- #
# Config resolution
# --------------------------------------------------------------------------- #

def parse_kv(raw):
    """Parse an OTel `k=v,k=v` list. Values are percent-decoded per spec."""
    out = {}
    if not raw:
        return out
    for item in raw.split(","):
        if "=" not in item:
            continue
        key, _, value = item.partition("=")
        key = key.strip()
        if not key:
            continue
        out[key] = urllib.parse.unquote(value.strip())
    return out


def managed_settings_path():
    if sys.platform == "darwin":
        return Path("/Library/Application Support/ClaudeCode/managed-settings.json")
    if os.name == "nt":
        return Path(r"C:\Program Files\ClaudeCode\managed-settings.json")
    return Path("/etc/claude-code/managed-settings.json")


def config_dir():
    """Claude Code's per-user config directory (`~/.claude`, or
    CLAUDE_CONFIG_DIR). Same resolution as `session_ticket_file`."""
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def _merge_env(paths):
    """Merged `env` blocks of the given settings files; later files win.
    Unreadable or malformed files are skipped."""
    merged = {}
    for path in paths:
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        env = data.get("env") if isinstance(data, dict) else None
        if isinstance(env, dict):
            merged.update({k: str(v) for k, v in env.items() if v is not None})
    return merged


def settings_env(cwd):
    """The `env` blocks of every settings file Claude Code loads, as two maps:
    (user_env, managed_env).

    user_env merges user < project < project local. managed_env merges
    endpoint-managed < server-managed: `managed-settings.json`, then the
    `managed-settings.d/` drop-ins beside it in name order, then
    `<config>/remote-settings.json` — the cache of the settings an org admin
    sets in the claude.ai console. In a fleet rolled out that way the cache is
    the ONLY place the OTLP endpoint exists: no managed-settings.json on disk,
    nothing in the user's settings.json.

    They are returned separately because they sit on opposite sides of the
    process environment (see `resolve_config`). Reading the files is the
    primary source, not a fallback: settings-file `env` vars are not inherited
    by hook subprocesses, so `os.environ` only carries what the developer's
    shell exported.
    """
    user_paths = [config_dir() / "settings.json"]
    if cwd:
        user_paths.append(Path(cwd) / ".claude" / "settings.json")
        user_paths.append(Path(cwd) / ".claude" / "settings.local.json")

    managed = managed_settings_path()
    managed_paths = [managed]
    try:
        managed_paths.extend(sorted((managed.parent / "managed-settings.d").glob("*.json")))
    except Exception:
        pass
    managed_paths.append(config_dir() / "remote-settings.json")

    return _merge_env(user_paths), _merge_env(managed_paths)


def resolve_config(payload):
    """Build the emitter config, or return (None, reason) when telemetry is
    unroutable (no endpoint, or a protocol we cannot speak).

    The routing keys — endpoint, protocol and headers — are resolved per tier
    and then across tiers, managed settings winning: for each key the highest
    tier that sets it (managed `env` > process environment > user/project `env`,
    see `settings_env`) decides, and OTel's per-signal alias beats the generic
    one *within* that tier. Managed settings thus lock the destination the
    organization chose; nothing a user exports in a shell or writes in a dotfile
    — not even through the per-signal OTEL_EXPORTER_OTLP_LOGS_ENDPOINT alias —
    can redirect the telemetry, because a lower tier is never consulted once a
    higher one has set the route. (Resolving on a single merged map instead
    would leak exactly that redirect: the per-signal and generic aliases are
    distinct keys, so a lower tier's per-signal one would survive the merge and
    then win OTel precedence over a higher tier's generic one.)

    Non-routing reads — the organization's static resource attributes and our
    own boolean flags — still come from a merged map where managed wins per key.

    There is deliberately no plugin-specific override of the endpoint, headers
    or protocol: the destination belongs to the organization and comes from its
    managed settings, never from something a user can point elsewhere.
    """
    cwd = payload.get("cwd") or os.getcwd()
    user_env, managed_env = settings_env(cwd)
    process_env = {k: v for k, v in os.environ.items() if v}
    # Highest priority first. Routing keys are read tier by tier off this order,
    # never off a flattened map, so a lower tier cannot reroute a higher one.
    tiers = (managed_env, process_env, user_env)

    def signal(specific, generic, transform=None):
        """First tier that sets either alias decides; within it the per-signal
        value wins, else the generic one (through `transform`)."""
        for tier in tiers:
            value = tier.get(specific) or None
            if value:
                return value
            base = tier.get(generic) or None
            if base:
                return transform(base) if transform else base
        return None

    # The merged map (managed wins per key) backs only the non-routing reads.
    env = dict(user_env)
    env.update(process_env)
    env.update(managed_env)

    def get(name):
        return env.get(name) or None

    # No opt-in and no kill switch: the hook always emits when it has somewhere
    # to send to. The only reasons to stay silent are missing routing data (no
    # endpoint) or a transport we cannot speak (grpc).
    endpoint = signal(
        "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        transform=lambda base: base.rstrip("/") + "/v1/logs",
    )
    if not endpoint:
        return None, "no OTLP logs endpoint configured"

    protocol = (
        signal("OTEL_EXPORTER_OTLP_LOGS_PROTOCOL", "OTEL_EXPORTER_OTLP_PROTOCOL")
        or DEFAULT_PROTOCOL
    )
    if protocol == "grpc":
        # We only speak OTLP over HTTP; the org's logs route must be http/*.
        return None, "grpc protocol unsupported; configure an http/protobuf or http/json logs endpoint"

    # Headers come whole from the same winning tier as the rest of the route, so
    # a lower tier cannot pin auth headers onto a managed endpoint. Within that
    # tier the per-signal headers merge over the generic ones.
    headers = {}
    for tier in tiers:
        generic = tier.get("OTEL_EXPORTER_OTLP_HEADERS") or None
        specific = tier.get("OTEL_EXPORTER_OTLP_LOGS_HEADERS") or None
        if generic or specific:
            headers = parse_kv(generic)
            headers.update(parse_kv(specific))
            break
    # The inherited headers may pin a content-type for the native exporter's
    # encoding; ours is decided by `protocol`, so drop any inherited copy.
    headers = {k: v for k, v in headers.items() if k.lower() != "content-type"}

    # Carry the organization's static resource attributes (department, cost
    # center) onto our records too, so they filter like the native events.
    resource = parse_kv(get("OTEL_RESOURCE_ATTRIBUTES"))
    resource["service.name"] = (
        get("OTEL_SERVICE_NAME") or resource.get("service.name") or DEFAULT_SERVICE_NAME
    )

    return {
        "endpoint": endpoint,
        "protocol": protocol,
        "headers": headers,
        "resource": resource,
        "cwd": cwd,
        "git_dirty": get("AFYAPOWERS_CORE_OTEL_GIT_DIRTY") == "1",
        "debug": get("AFYAPOWERS_CORE_OTEL_DEBUG") == "1",
    }, None


# --------------------------------------------------------------------------- #
# Debug trace
# --------------------------------------------------------------------------- #

def debug_log(cwd, record):
    """Append one JSON line describing what happened. Best effort."""
    try:
        base = Path(cwd or ".") / ".afyapowers"
        target = (
            base if base.is_dir() else Path(tempfile.gettempdir())
        ) / "otel-debug.jsonl"
        record["ts"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        with open(target, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(record, ensure_ascii=False) + "\n")
    except Exception:
        pass


# --------------------------------------------------------------------------- #
# Plugin version (child only)
# --------------------------------------------------------------------------- #

# Manifest location relative to the plugin root, one entry per host IDE: Claude
# Code and Cursor namespace theirs in a dot-directory, GitHub Copilot keeps it at
# the root. This file is always at <plugin root>/hooks/, so the root is its parent.
MANIFEST_RELATIVE_PATHS = (
    ".claude-plugin/plugin.json",
    ".cursor-plugin/plugin.json",
    "plugin.json",
)

# Header line of `claude plugin details afyapowers-core`: `afyapowers-core <version>`.
CLI_VERSION_RE = re.compile(r"^afyapowers-core\s+v?(\d[\w.+-]*)$")
# Terminal control sequences the CLI interleaves with its output (CSI colors and
# OSC title/color queries), stripped before the header line is matched.
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")


def version_from_manifest():
    """Read the version out of the plugin manifest shipped beside this hook.

    This is the same number `claude plugin details` prints — the CLI reads this
    very file — but without a subprocess, and it works under every host IDE.
    """
    root = Path(__file__).resolve().parent.parent
    for relative in MANIFEST_RELATIVE_PATHS:
        try:
            data = json.loads((root / relative).read_text(encoding="utf-8"))
        except Exception:
            continue
        version = data.get("version") if isinstance(data, dict) else None
        if version:
            return str(version)
    return None


def version_from_cli():
    """Fallback for layouts with no manifest beside the hook (a Gemini
    distribution, or a source checkout run directly): ask the CLI. Only the
    header line is parsed — everything after it is the component inventory."""
    try:
        result = subprocess.run(
            ["claude", "plugin", "details", "afyapowers-core"],
            capture_output=True,
            text=True,
            timeout=CLI_TIMEOUT,
        )
    except Exception:
        return None
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        match = CLI_VERSION_RE.match(ANSI_RE.sub("", line).strip())
        if match:
            return match.group(1)
    return None


def plugin_version():
    return version_from_manifest() or version_from_cli()


def _relevant_to_session(entry, cwd):
    """A user/managed-scope install always applies; a project-scope install
    applies only when the session's cwd lives inside that project."""
    if entry.get("scope") != "project":
        return True
    project = entry.get("projectPath")
    if not project:
        return False
    cwd = os.path.realpath(cwd)
    project = os.path.realpath(project)
    return cwd == project or cwd.startswith(project + os.sep)


def afyapowers_plugin_versions(cwd):
    """Versions of every installed afyapowers-family plugin relevant to this
    session, keyed `<name with "-" -> "_">.version` (afyapowers_core.version,
    afyapowers_design.version, ...).

    Sourced from `claude plugin list --json`, which reports one entry per
    install: the same plugin can appear once per project scope plus a user
    scope, so entries are filtered to the session (user scope, or project
    scope covering cwd) and deduplicated per plugin — an enabled install
    beats a disabled one, then the most recently updated wins.

    Unlike the fixed schema these keys are dynamic: present only for plugins
    that are installed, never as explicit nulls, since the full family roster
    is unknowable here. Any failure (no `claude` CLI under other host IDEs,
    timeout, unparseable output) -> {} — the legacy afyapowers.version
    attribute still carries the core version on its own.
    """
    try:
        result = subprocess.run(
            ["claude", "plugin", "list", "--json"],
            capture_output=True,
            text=True,
            timeout=CLI_TIMEOUT,
        )
    except Exception:
        return {}
    if result.returncode != 0:
        return {}
    try:
        entries = json.loads(result.stdout)
    except Exception:
        # Defensive: some CLI paths interleave terminal control sequences.
        try:
            entries = json.loads(ANSI_RE.sub("", result.stdout))
        except Exception:
            return {}
    if not isinstance(entries, list):
        return {}

    candidates = {}
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        name = str(entry.get("id") or "").partition("@")[0]
        if not name.startswith("afyapowers"):
            continue
        if not entry.get("version"):
            continue
        if not _relevant_to_session(entry, cwd):
            continue
        candidates.setdefault(name, []).append(entry)

    versions = {}
    for name, installs in candidates.items():
        # lastUpdated is ISO-8601 UTC, so lexicographic order is time order.
        best = max(
            installs,
            key=lambda e: (bool(e.get("enabled")), str(e.get("lastUpdated") or "")),
        )
        versions[name.replace("-", "_") + ".version"] = str(best["version"])
    return versions


# --------------------------------------------------------------------------- #
# Jira ticket (child only, per session)
# --------------------------------------------------------------------------- #

JIRA_KEY_RE = re.compile(r"^[A-Z][A-Z0-9]+-\d+$")


def session_ticket_file(session_id):
    """Per-session ticket file maintained by the model under the jira-context
    hook's instructions: `<config>/afyapowers-core/sessions/<id>/jira-ticket`.
    Location and sanitizing mirror hooks/jira-context (and statusline.py)."""
    if not session_id:
        return None
    base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    if not base or base.startswith("~"):
        return None
    safe = "".join(c if (c.isalnum() or c in "-_") else "-" for c in str(session_id))
    if not safe:
        return None
    return Path(base) / "afyapowers-core" / "sessions" / safe / "jira-ticket"


def jira_key(session_id):
    """Ticket confirmed by the user for THIS session. Deliberately no fallback
    to the project pointer `.afyapowers/current-jira-ticket`: two sessions in
    the same folder share that file, which is exactly the misattribution this
    per-session file exists to avoid. The literal `none` means the user
    explicitly works without a ticket; garbage or a missing file (including the
    first prompt of a session, answered only after this hook has fired) mean
    the same to telemetry — the caller sends jira.key as an explicit null
    (ATTR_NULL) in those cases."""
    path = session_ticket_file(session_id)
    if path is None:
        return None
    try:
        raw = path.read_text(encoding="utf-8").strip()
    except Exception:
        return None
    if raw.lower() == "none":
        return None
    raw = raw.upper()
    return raw if JIRA_KEY_RE.match(raw) else None


# --------------------------------------------------------------------------- #
# Active feature phase (child only)
# --------------------------------------------------------------------------- #

def feature_phase(cwd):
    """Current workflow phase of the active afyapowers-dev feature.

    Optional by design: a missing file, an empty/`null` pointer, an unsafe
    slug or an absent `current_phase:` line all mean the attribute is not
    emitted at all (unlike jira.key, which is always present as an explicit
    null). state.yaml is read with a line scan instead of a YAML parser to
    stay stdlib-only; anchoring on column 0 skips the indented per-phase
    entries under `phases:`.
    """
    try:
        features = Path(cwd) / ".afyapowers" / "features"
        slug = (features / "active").read_text(encoding="utf-8").strip()
        if not slug or slug.lower() == "null" or Path(slug).name != slug:
            return None
        text = (features / slug / "state.yaml").read_text(encoding="utf-8")
    except Exception:
        return None
    for line in text.splitlines():
        if line.startswith("current_phase:"):
            return line[len("current_phase:"):].strip() or None
    return None


# --------------------------------------------------------------------------- #
# Host and account identity (child only)
# --------------------------------------------------------------------------- #

def account_config_path():
    """Path to Claude Code's main config file (`.claude.json`), which holds the
    logged-in account. It lives at `$CLAUDE_CONFIG_DIR/.claude.json` when that
    var is set, else `~/.claude.json`. Note it is a SIBLING of the `~/.claude`
    config dir, not a file inside it, so this cannot reuse `config_dir()`."""
    base = os.environ.get("CLAUDE_CONFIG_DIR")
    return (Path(base) if base else Path.home()) / ".claude.json"


def account_email():
    """Email of the Claude account logged in on this machine, from
    `oauthAccount.emailAddress` in the main config — the same identity the native
    claude_code.* events carry as user.email. None when logged out, on a host IDE
    that stores auth elsewhere, or if the file is missing/unreadable, so the
    attribute is omitted (optional, never an explicit null)."""
    try:
        data = json.loads(account_config_path().read_text(encoding="utf-8"))
    except Exception:
        return None
    account = data.get("oauthAccount") if isinstance(data, dict) else None
    if not isinstance(account, dict):
        return None
    return account.get("emailAddress") or None


def hostname():
    """This machine's network hostname, or None if it cannot be determined."""
    try:
        return socket.gethostname() or None
    except Exception:
        return None


# --------------------------------------------------------------------------- #
# Git attributes (child only)
# --------------------------------------------------------------------------- #

def git(cwd, *args):
    try:
        result = subprocess.run(
            ["git", "-C", cwd, *args],
            capture_output=True,
            text=True,
            timeout=GIT_TIMEOUT,
        )
    except Exception:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


# Path segments that hosting providers inject into clone URLs and that carry no
# identity: Azure DevOps uses `.../_git/<repo>`, Bitbucket Server `.../scm/...`.
REMOTE_NOISE_SEGMENTS = {"_git", "scm"}


def remote_slug(url):
    """Turn a clone URL into an `owner/repo` slug.

    Handles scp-like (`git@host:owner/repo.git`), ssh:// and https:// forms,
    including nested GitLab groups and Azure DevOps `_git` paths. Only the path
    is ever used, never the authority — a clone URL can embed credentials
    (`https://user:token@host/...`) and those must not reach telemetry.

    Returns None for a remote that is a local filesystem path: it identifies
    nothing outside the machine it came from, and shipping it would leak the
    developer's directory layout into telemetry.
    """
    if not url:
        return None
    url = url.strip()

    if "://" in url:
        path = urllib.parse.urlsplit(url).path
    else:
        host, sep, rest = url.partition(":")
        # scp-like syntax needs a colon with no slash before it, over a host of
        # more than one character — a single letter is a Windows drive.
        if not sep or "/" in host or len(host) < 2:
            return None
        path = rest

    if path.endswith(".git"):
        path = path[: -len(".git")]

    segments = [
        seg for seg in path.split("/") if seg and seg not in REMOTE_NOISE_SEGMENTS
    ]
    return "/".join(segments) or None


def git_remote_url(cwd):
    """Clone URL of `origin`, or of the first remote when there is no `origin`."""
    url = git(cwd, "remote", "get-url", "origin")
    if url:
        return url
    remotes = git(cwd, "remote")
    if not remotes:
        return None
    return git(cwd, "remote", "get-url", remotes.splitlines()[0].strip())


# Every git attribute this hook can carry. The record always has all of them,
# as a value or as an explicit null, so the backend sees one stable schema.
GIT_ATTR_KEYS = ("git.repo", "git.branch", "git.commit", "git.dirty")


def git_attrs(cwd, want_dirty):
    """Collect git context. Never returns None.

    Whatever cannot be resolved — no repo at all, no commits yet, dirty-checking
    switched off — comes back as ATTR_NULL rather than being left out, because a
    missing attribute and a null one are different facts to a query, and an
    unenrichable session must still produce a record.

    Separate calls on purpose: `git rev-parse` flags are sticky, so combining
    --abbrev-ref/--short/--show-toplevel returns values in an unpredictable
    order. This runs in the detached child, so the extra forks are free.
    """
    attrs = dict.fromkeys(GIT_ATTR_KEYS, ATTR_NULL)

    toplevel = git(cwd, "rev-parse", "--show-toplevel")
    if not toplevel:
        return attrs  # not a git repo — every git attribute stays null

    # Prefer the remote slug: the local folder name is whatever each developer
    # happened to clone into, so it cannot identify a repo across a fleet.
    attrs["git.repo"] = (
        remote_slug(git_remote_url(cwd)) or os.path.basename(toplevel) or ATTR_NULL
    )

    # Empty in detached HEAD, a state worth distinguishing from a branch.
    attrs["git.branch"] = git(cwd, "branch", "--show-current") or "detached"

    # Null in a repo with no commits yet.
    attrs["git.commit"] = git(cwd, "rev-parse", "--short", "HEAD") or ATTR_NULL

    # Opt-in: `git status` walks the whole tree, which costs seconds in a
    # monorepo. Left null when off — "not measured", not "clean".
    if want_dirty:
        attrs["git.dirty"] = "true" if git(cwd, "status", "--porcelain") else "false"

    return attrs


# --------------------------------------------------------------------------- #
# OTLP encoding — protobuf
# --------------------------------------------------------------------------- #
# Hand-rolled because the plugin is stdlib-only. Field numbers come from the
# OTLP proto definitions (common/v1/common.proto, resource/v1/resource.proto,
# logs/v1/logs.proto) and must not be renumbered.

def _varint(value):
    out = bytearray()
    while True:
        byte = value & 0x7F
        value >>= 7
        out.append(byte | (0x80 if value else 0))
        if not value:
            return bytes(out)


def _tag(field, wire_type):
    return _varint((field << 3) | wire_type)


def _pb_string(field, text):
    raw = str(text).encode("utf-8")
    return _tag(field, 2) + _varint(len(raw)) + raw


def _pb_message(field, body):
    return _tag(field, 2) + _varint(len(body)) + body


def _pb_varint(field, value):
    return _tag(field, 0) + _varint(value)


def _pb_fixed64(field, value):
    return _tag(field, 1) + struct.pack("<Q", value)


def _pb_key_values(field, mapping):
    """repeated KeyValue { key = 1; AnyValue value = 2 { string_value = 1 } }

    ATTR_NULL encodes as an empty AnyValue (no oneof field set) — the OTLP
    representation of null; None/"" drop the attribute entirely."""
    out = b""
    for key, value in mapping.items():
        if value is ATTR_NULL:
            any_value = b""
        elif value in (None, ""):
            continue
        else:
            any_value = _pb_string(1, value)
        out += _pb_message(field, _pb_string(1, key) + _pb_message(2, any_value))
    return out


def encode_protobuf(resource, attrs, time_ns):
    # LogRecord: time_unix_nano=1, severity_number=2, severity_text=3, body=5,
    #            attributes=6, observed_time_unix_nano=11
    log_record = (
        _pb_fixed64(1, time_ns)
        + _pb_varint(2, SEVERITY_INFO)
        + _pb_string(3, "INFO")
        + _pb_message(5, _pb_string(1, EVENT_NAME))
        + _pb_key_values(6, attrs)
        + _pb_fixed64(11, time_ns)
    )
    # ScopeLogs: scope=1 (InstrumentationScope { name = 1 }), log_records=2
    scope_logs = _pb_message(1, _pb_string(1, SCOPE_NAME)) + _pb_message(2, log_record)
    # ResourceLogs: resource=1 (Resource { attributes = 1 }), scope_logs=2
    resource_logs = _pb_message(1, _pb_key_values(1, resource)) + _pb_message(2, scope_logs)
    # LogsData: resource_logs=1
    return _pb_message(1, resource_logs)


# --------------------------------------------------------------------------- #
# OTLP encoding — JSON
# --------------------------------------------------------------------------- #

def _json_attributes(mapping):
    """ATTR_NULL encodes as an empty AnyValue ({}) — the OTLP representation
    of null; None/"" drop the attribute entirely."""
    out = []
    for k, v in mapping.items():
        if v is ATTR_NULL:
            out.append({"key": k, "value": {}})
        elif v not in (None, ""):
            out.append({"key": k, "value": {"stringValue": str(v)}})
    return out


def encode_json(resource, attrs, time_ns):
    return json.dumps(
        {
            "resourceLogs": [
                {
                    "resource": {"attributes": _json_attributes(resource)},
                    "scopeLogs": [
                        {
                            "scope": {"name": SCOPE_NAME},
                            "logRecords": [
                                {
                                    "timeUnixNano": str(time_ns),
                                    "observedTimeUnixNano": str(time_ns),
                                    "severityNumber": SEVERITY_INFO,
                                    "severityText": "INFO",
                                    "body": {"stringValue": EVENT_NAME},
                                    "attributes": _json_attributes(attrs),
                                }
                            ],
                        }
                    ],
                }
            ]
        }
    ).encode("utf-8")


# --------------------------------------------------------------------------- #
# Emission (child only)
# --------------------------------------------------------------------------- #

def emit(config, payload):
    """Send exactly one record per invocation.

    Once we are here the emitter is configured and routable, so a record goes
    out unconditionally: no input is treated as a reason to stay silent. Every
    fixed-schema attribute below is always present — a real value or an explicit
    null — so a session outside a repo, before the first prompt, or without a
    ticket is still visible in the backend rather than absent from it. Optional
    attributes (plugin versions, feature phase) are instead omitted entirely
    when they have no value.
    """
    cwd = config["cwd"]

    # session.id / prompt.id are the join keys against the native claude_code.*
    # events — structural, not optional. prompt_id is absent before first input.
    attrs = {
        "event.name": EVENT_NAME,
        "session.id": payload.get("session_id") or ATTR_NULL,
        "prompt.id": payload.get("prompt_id") or ATTR_NULL,
        "hook.event": payload.get("hook_event_name") or ATTR_NULL,
        # Always present; explicit null until the user confirms the ticket for
        # this session (so the first record of every session is null).
        "jira.key": jira_key(payload.get("session_id")) or ATTR_NULL,
        # Which plugin build produced this session — lets the backend correlate a
        # behavior change with the release that shipped it.
        "afyapowers.version": plugin_version() or ATTR_NULL,
        **git_attrs(cwd, config["git_dirty"]),
    }
    # Optional host/account identity: user.email mirrors the native claude_code.*
    # events, host.name follows OTel host semconv. Omitted (never null) when
    # unresolvable — logged out, or a host IDE that stores auth elsewhere.
    email = account_email()
    if email:
        attrs["user.email"] = email
    host = hostname()
    if host:
        attrs["host.name"] = host
    # Optional workflow context: only present when an afyapowers-dev feature is
    # active and its state.yaml names a phase — never emitted as null.
    phase = feature_phase(cwd)
    if phase:
        attrs["afyapowers_dev.current_phase"] = phase
    # Per-plugin versions of the whole afyapowers family. Ordering is the
    # collision rule: a plugin literally named "afyapowers" maps to
    # "afyapowers.version" and takes the key over the manifest value above
    # (the core version always remains under afyapowers_core.version).
    attrs.update(afyapowers_plugin_versions(cwd))

    time_ns = time.time_ns()
    if config["protocol"] == "http/json":
        body, content_type = encode_json(config["resource"], attrs, time_ns), "application/json"
    else:
        body, content_type = (
            encode_protobuf(config["resource"], attrs, time_ns),
            "application/x-protobuf",
        )

    request = urllib.request.Request(
        config["endpoint"], data=body, headers={"Content-Type": content_type}
    )
    for key, value in config["headers"].items():
        request.add_header(key, value)

    status, error = None, None
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
            status = response.status
    except Exception as exc:  # network, TLS, auth, collector down — all silent
        error = "{}: {}".format(type(exc).__name__, exc)

    if config["debug"]:
        debug_log(
            cwd,
            {
                "endpoint": config["endpoint"],
                "protocol": config["protocol"],
                "status": status,
                "error": error,
                # ATTR_NULL is not JSON-serializable; log it as a real null.
                "attributes": {
                    k: (None if v is ATTR_NULL else v) for k, v in attrs.items()
                },
            },
        )


# --------------------------------------------------------------------------- #
# Entrypoints
# --------------------------------------------------------------------------- #

def spawn_detached(blob):
    """Hand the work to a detached child so the hook never blocks the prompt."""
    kwargs = {
        "stdin": subprocess.PIPE,
        "stdout": subprocess.DEVNULL,
        "stderr": subprocess.DEVNULL,
    }
    if os.name == "nt":
        DETACHED_PROCESS = 0x00000008
        CREATE_NEW_PROCESS_GROUP = 0x00000200
        kwargs["creationflags"] = DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    else:
        kwargs["start_new_session"] = True

    child = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--emit"], **kwargs
    )
    child.stdin.write(blob.encode("utf-8"))
    child.stdin.close()  # no wait() — the child outlives us


def run_hook():
    payload = json.loads(sys.stdin.read() or "{}")
    config, reason = resolve_config(payload)
    if config is None:
        if os.environ.get("AFYAPOWERS_CORE_OTEL_DEBUG") == "1":
            debug_log(payload.get("cwd"), {"skipped": reason})
        return
    spawn_detached(json.dumps({"config": config, "payload": payload}))


def run_emit():
    blob = json.loads(sys.stdin.read() or "{}")
    config, payload = blob.get("config"), blob.get("payload") or {}
    if not isinstance(config, dict):
        # Invoked directly for testing: resolve config from the environment.
        config, _ = resolve_config(payload)
        if config is None:
            return
    if not config.get("endpoint"):
        return
    config.setdefault("protocol", DEFAULT_PROTOCOL)
    config.setdefault("cwd", payload.get("cwd") or os.getcwd())
    config.setdefault("headers", {})
    config.setdefault("resource", {"service.name": DEFAULT_SERVICE_NAME})
    config.setdefault("git_dirty", False)
    config.setdefault("debug", os.environ.get("AFYAPOWERS_CORE_OTEL_DEBUG") == "1")
    emit(config, payload)


def main():
    try:
        if "--emit" in sys.argv[1:]:
            run_emit()
        else:
            run_hook()
    except Exception:
        pass  # observability must never break a session
    sys.exit(0)


if __name__ == "__main__":
    main()
