#!/usr/bin/env python3
"""afyapowers-core Jira ticket context (SessionStart + UserPromptSubmit + PostToolUse).

The single owner of the Jira ticket flow. Context injected at SessionStart
arrives before the first prompt and the model routinely ignores it when it
starts acting (same lesson that moved lang-directive to per-skill injection),
so the question is injected WITH the user's prompt — the moment the model is
deciding what to do — and framed as the FIRST action of the turn. Once the
model has read a file or invoked a skill it is already committed to the
request, and the question either never comes or arrives too late to tag the
work.

State is PER SESSION, not per project. Two Claude Code sessions open in the
same folder are two different pieces of work, so each one records its own
answer under the user's Claude config dir:

    <config>/afyapowers-core/sessions/<session_id>/
      jira-ticket   written by this hook (PostToolUse on AskUserQuestion):
                    `ABC-123` or the literal `none`

`jira-ticket` is what otel-context stamps on telemetry and what the status
line renders — both resolve it by the session id they already receive. There
is no project-level pointer anymore: a file shared by every session in the
folder is exactly what let one session's answer leak into another's telemetry.

The question is asked ONCE per session, and dedup is by state on disk, not by
the model's memory:

  * No session file -> the question goes out with the prompt, recommending
    the branch key when the branch has one and typing the id otherwise ("no
    ticket" is always offered, never recommended: the goal is to identify the
    ticket). Outside a git work tree there is no branch to infer from, but the
    question is asked all the same. As long as the file is missing the
    question repeats (the user dismissed it, or the model skipped it).

  * The answer is persisted BY THIS HOOK, not by the model. The question is
    asked through AskUserQuestion with a fixed header (`Jira ticket`); the
    PostToolUse hook on that tool recognises that exact header (nothing else:
    an unrelated question mentioning Jira is ignored), reads the chosen answer
    and writes the session file — only while the file does not exist yet, so
    no later question can rewrite it. Delegating the write to the model was
    the source of repeated questions: in plan mode it cannot write files at
    all, and outside plan mode it sometimes just does not. The model only
    writes the file itself as a fallback when AskUserQuestion is unavailable.

  * Session file present -> a one-line context with the ticket and an
    explicit "do not ask again". Nothing re-asks: not a branch switch, not a
    change of subject. The ticket holds for the whole session; a new session
    starts from scratch. Survives `/compact`, and `--resume` inside the prune
    window does not re-ask.

Never touches the project: all state lives under the Claude config dir, so
`.afyapowers/` is neither created nor required (its presence marks a project
as afyapowers-enabled — owned by afyapowers-dev). Never blocks: any error ->
exit 0, and nothing but the expected JSON is ever written to stdout (on
UserPromptSubmit it is injected as context).

SessionStart is housekeeping only: create `sessions/` and prune entries unused
for more than 7 days (the session file is touched on every prompt, so a live or
recently resumed session never expires while in use).
"""

import itertools
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

JIRA_KEY_RE = re.compile(r"^[A-Z][A-Z0-9]+-\d+$")
BRANCH_KEY_RE = re.compile(r"[A-Z][A-Z0-9]+-[0-9]+", re.IGNORECASE)
SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")
GIT_TIMEOUT = 2
PRUNE_AGE_S = 7 * 24 * 3600
PRUNE_CAP = 1000
SESSION_FILE = "jira-ticket"
# `branch-key` was written by 1.2/1.3 next to the session file; it is no
# longer produced but stays in OWNED_FILES so prune still cleans old dirs.
OWNED_FILES = (SESSION_FILE, "branch-key")
# Header the model must give the AskUserQuestion (<= 12 chars); it is how the
# PostToolUse hook tells the Jira question apart from any other question.
QUESTION_HEADER = "Jira ticket"
NO_TICKET_PREFIXES = ("no specific task", "none", "no ticket", "sem ticket", "nenhum")


# --------------------------------------------------------------------------- #
# Session state location (mirrored in otel-context and scripts/statusline.py)
# --------------------------------------------------------------------------- #

def config_dir():
    """`${CLAUDE_CONFIG_DIR:-~/.claude}`; None when HOME cannot be resolved
    (expanduser then returns the literal `~`, which would otherwise create a
    `~` directory relative to cwd)."""
    base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    if not base or base.startswith("~"):
        return None
    return Path(base)


def sessions_root():
    base = config_dir()
    return base / "afyapowers-core" / "sessions" if base else None


def sanitize(session_id):
    return "".join(c if (c.isalnum() or c in "-_") else "-" for c in str(session_id))


def session_dir(session_id):
    root = sessions_root()
    if root is None or not session_id:
        return None
    safe = sanitize(session_id)
    return root / safe if safe else None


def read_key(path):
    """One-line ticket file -> None (missing, empty or garbage: nobody has
    answered), the literal `none` (explicitly no ticket) or a validated key."""
    try:
        raw = Path(path).read_text(encoding="utf-8").strip()
    except Exception:
        return None
    if not raw:
        return None
    if raw.lower() == "none":
        return "none"
    raw = raw.upper()
    return raw if JIRA_KEY_RE.match(raw) else None


def write_text(path, text):
    try:
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        Path(path).write_text(text, encoding="utf-8")
    except Exception:
        pass


# --------------------------------------------------------------------------- #
# Git
# --------------------------------------------------------------------------- #

def git(cwd, *args):
    try:
        result = subprocess.run(
            ["git", "-C", cwd, *args],
            capture_output=True,
            text=True,
            timeout=GIT_TIMEOUT,
        )
    except Exception:
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def branch_key(cwd):
    """First `ABC-123`-shaped token in the branch name, normalized to upper
    case; empty when the branch has none or HEAD is detached. The match is
    case-insensitive because branches routinely carry the key in lower case
    (`feature/abc-123-...`); the returned key is upper-cased to line up with
    the recorded ticket, which `read_key` always stores upper-cased."""
    match = BRANCH_KEY_RE.search(git(cwd, "branch", "--show-current") or "")
    return match.group(0).upper() if match else ""


# --------------------------------------------------------------------------- #
# SessionStart: housekeeping
# --------------------------------------------------------------------------- #

def prune(root):
    """Remove session dirs whose owned files were all last touched more than
    PRUNE_AGE_S ago. Only names we could have created, never symlinks, only
    our own files; rmdir fails harmlessly if anything else is inside."""
    now = time.time()
    try:
        with os.scandir(root) as it:
            entries = list(itertools.islice(it, PRUNE_CAP))
    except OSError:
        return
    for entry in entries:
        try:
            if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
                continue
            if not SAFE_NAME_RE.match(entry.name):
                continue
            newest = 0.0
            for name in OWNED_FILES:
                try:
                    newest = max(newest, os.lstat(os.path.join(entry.path, name)).st_mtime)
                except OSError:
                    pass
            if newest and now - newest < PRUNE_AGE_S:
                continue
            for name in OWNED_FILES:
                try:
                    os.unlink(os.path.join(entry.path, name))
                except OSError:
                    pass
            try:
                os.rmdir(entry.path)
            except OSError:
                pass
        except OSError:
            pass


def run_session_start():
    root = sessions_root()
    if root is not None:
        try:
            root.mkdir(parents=True, exist_ok=True)
        except OSError:
            pass
        prune(root)
    print("{}")


# --------------------------------------------------------------------------- #
# UserPromptSubmit: the question / the one-line context
# --------------------------------------------------------------------------- #

PRIORITY = "TOP PRIORITY — handle this before anything else in this turn."
ASK = "Ask the user NOW — use the AskUserQuestion tool when available —"
BLOCK_RULES = (
    "Ask before you do anything else: no other tool call, no reading or searching "
    "files, no skill invocation, no plan or todo list, and no answer to any part of "
    "the request until the user has answered. Do not start the work and ask afterwards."
)


def persist_rules(session_file):
    return (
        "Use exactly {} as the AskUserQuestion header: a hook records the answer "
        "automatically from that question, so do NOT write any file yourself. Only if "
        "AskUserQuestion is unavailable, ask in plain text and, once answered, write the "
        "session file {} yourself — create its parent directories if needed — as exactly "
        "one line with no trailing newline: the chosen key uppercase (e.g. ABC-123), or "
        "the literal none."
    ).format(json.dumps(QUESTION_HEADER), json.dumps(str(session_file)))


def describe(key):
    return "none (working without a ticket)" if key == "none" else key


def ask_unset(bkey, session_file):
    """Nobody has answered in this session: ask, recommending the branch key
    when there is one, else typing the id. "No specific task" is always
    offered but never recommended."""
    options = []
    if bkey:
        options.append("'{} (from branch) (Recommended)'".format(bkey))
        options.append("'Another ticket id' (the user types it, e.g. ABC-123)")
    else:
        options.append("'Another ticket id (Recommended)' (the user types it, e.g. ABC-123)")
    options.append("'No specific task'")
    return "{} The Jira ticket for this session is not set. {} which Jira ticket this work belongs to. Options: {}. {} {}".format(
        PRIORITY, ASK, ", ".join(options), BLOCK_RULES, persist_rules(session_file)
    )


def resolved(session_key):
    """Answered: one line so the model knows the ticket (commits, PRs), and an
    explicit instruction never to ask again in this session."""
    return (
        "Jira ticket for this session: {}. It was already confirmed by the user for "
        "this whole session — do not ask about the Jira ticket again, even if the task, "
        "branch or subject changes."
    ).format(describe(session_key))


def run_prompt(payload):
    session_id = payload.get("session_id")
    cwd = payload.get("cwd") or os.getcwd()
    if not session_id:
        return  # without a session there is nothing to attach the ticket to

    sdir = session_dir(session_id)
    if sdir is None:
        return
    session_file = sdir / SESSION_FILE
    session_key = read_key(session_file)

    if session_key is None:
        # Outside a git work tree `branch_key` is simply empty: the question is
        # asked everywhere, only the recommendation needs a repo.
        msg = ask_unset(branch_key(cwd), session_file)
    else:
        msg = resolved(session_key)
        # Keep the live session out of the prune window.
        try:
            os.utime(session_file, None)
        except OSError:
            pass

    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": msg,
        }
    }))


# --------------------------------------------------------------------------- #
# PostToolUse (AskUserQuestion): persist the answer
# --------------------------------------------------------------------------- #

def is_jira_question(question):
    """Only the fixed header counts. No fuzzy fallback on the question text:
    an unrelated question that merely mentions Jira ("link the Jira ticket in
    the PR?") must never be able to rewrite the session ticket."""
    header = str(question.get("header") or "").strip().lower()
    return header == QUESTION_HEADER.lower()


def find_answer(question_text, tool_response):
    """The answer to `question_text` out of the tool response. Structured
    shape (what Claude Code stores): {"answers": {question: label}}. Fallback:
    a text blob shaped `"<question>"="<answer>"` (the tool_result wording)."""
    if isinstance(tool_response, dict):
        answers = tool_response.get("answers")
        if isinstance(answers, dict) and question_text in answers:
            value = answers[question_text]
            if isinstance(value, list):
                value = value[0] if value else ""
            return str(value)
        text = tool_response.get("text") or tool_response.get("content") or ""
    else:
        text = tool_response or ""
    if isinstance(text, list):  # content blocks
        text = " ".join(str(b.get("text", "")) if isinstance(b, dict) else str(b) for b in text)
    text = str(text)
    match = re.search(re.escape(json.dumps(question_text)) + r'\s*=\s*"((?:[^"\\]|\\.)*)"', text)
    if match:
        try:
            return json.loads('"' + match.group(1) + '"')
        except ValueError:
            return match.group(1)
    return None


def parse_answer(text):
    """Chosen label or free text -> validated key, `none`, or None when the
    answer carries no decision (e.g. 'Another ticket id' picked without an id:
    the question will simply come back with the next prompt)."""
    if text is None:
        return None
    raw = str(text).strip()
    if not raw:
        return None
    match = BRANCH_KEY_RE.search(raw)
    if match:
        key = match.group(0).upper()
        return key if JIRA_KEY_RE.match(key) else None
    lowered = raw.lower()
    if lowered.startswith(NO_TICKET_PREFIXES):
        return "none"
    return None


def run_post_tool_use(payload):
    sdir = session_dir(payload.get("session_id"))
    if sdir is None:
        return
    session_file = sdir / SESSION_FILE
    if read_key(session_file) is not None:
        return  # asked once per session: an existing answer is never rewritten
    tool_input = payload.get("tool_input") or {}
    questions = tool_input.get("questions") if isinstance(tool_input, dict) else None
    if not isinstance(questions, list):
        return
    for question in questions:
        if not isinstance(question, dict) or not is_jira_question(question):
            continue
        answer = find_answer(str(question.get("question") or ""), payload.get("tool_response"))
        key = parse_answer(answer)
        if key is not None:
            write_text(session_file, key)
        return  # one Jira question per AskUserQuestion call


def main():
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
        if not isinstance(payload, dict):
            payload = {}
        event = payload.get("hook_event_name")
        if event == "SessionStart":
            run_session_start()
        elif event == "PostToolUse":
            if payload.get("tool_name") == "AskUserQuestion":
                run_post_tool_use(payload)
        else:
            run_prompt(payload)
    except Exception:
        pass  # context enrichment must never break a session
    sys.exit(0)


if __name__ == "__main__":
    main()
