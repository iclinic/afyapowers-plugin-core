#!/usr/bin/env python3
"""afyapowers-core Jira ticket context (UserPromptSubmit + SessionStart).

The single owner of the Jira ticket flow. Context injected at SessionStart
arrives before the first prompt and the model routinely ignores it when it
starts acting (same lesson that moved lang-directive to per-skill injection),
so the question is injected WITH the user's prompt — the moment the model is
deciding what to do — and framed as the FIRST action of the turn. Once the
model has read a file or invoked a skill it is already committed to the
request, and the question either never comes or arrives too late to tag the
work.

State is PER SESSION, not per project. Two Claude Code sessions open in the
same folder are two different pieces of work, so each one records its own
answer under the user's Claude config dir:

    <config>/afyapowers-core/sessions/<session_id>/
      jira-ticket   written by the model: `ABC-123` or the literal `none`
      branch-key    written by this hook: the ticket key extracted from the
                    git branch at the last prompt (empty when none)

`jira-ticket` is what otel-context stamps on telemetry and what the status
line renders — both resolve it by the session id they already receive. There
is no project-level pointer anymore: a file shared by every session in the
folder is exactly what let one session's answer leak into another's telemetry.

Dedup is by state on disk, not by the model's memory:

  1. Ask once per session. No session file -> the question goes out with the
     prompt (branch key as the recommended option when the branch has one),
     and the model is told the exact path to persist the answer to. As long
     as the file is missing the question repeats; once written it never comes
     back for this session — survives `/compact`, and `--resume` inside the
     prune window does not re-ask.

  2. Re-ask once per branch switch. `branch-key` remembers what the branch
     suggested last time; the conflict question fires only when that changed
     AND differs from the recorded ticket, so "keep ABC-1 although the branch
     says ABC-2" is honoured until the branch actually changes again.

  3. Re-ask on a topic shift. A confirmation covers only the work it was
     given for; the short per-prompt context reminds the model to ask again
     when a prompt starts a different task. This one stays instruction-based —
     only the model can tell the subject changed.

Never touches the project: all state lives under the Claude config dir, so
`.afyapowers/` is neither created nor required (its presence marks a project
as afyapowers-enabled — owned by afyapowers-dev). Never blocks: any error ->
exit 0, and nothing but the expected JSON is ever written to stdout (on
UserPromptSubmit it is injected as context).

SessionStart is housekeeping only: create `sessions/` and prune entries unused
for more than 7 days (the session file is touched on every prompt, so a live or
recently resumed session never expires while in use).
"""

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

JIRA_KEY_RE = re.compile(r"^[A-Z][A-Z0-9]+-\d+$")
BRANCH_KEY_RE = re.compile(r"[A-Z][A-Z0-9]+-[0-9]+")
SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")
GIT_TIMEOUT = 2
PRUNE_AGE_S = 7 * 24 * 3600
PRUNE_CAP = 1000
SESSION_FILE = "jira-ticket"
BRANCH_FILE = "branch-key"
OWNED_FILES = (SESSION_FILE, BRANCH_FILE)


# --------------------------------------------------------------------------- #
# Session state location (mirrored in otel-context and scripts/statusline.py)
# --------------------------------------------------------------------------- #

def config_dir():
    """`${CLAUDE_CONFIG_DIR:-~/.claude}`; None when HOME cannot be resolved
    (expanduser then returns the literal `~`, which would otherwise create a
    `~` directory relative to cwd)."""
    base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    if not base or base.startswith("~"):
        return None
    return Path(base)


def sessions_root():
    base = config_dir()
    return base / "afyapowers-core" / "sessions" if base else None


def sanitize(session_id):
    return "".join(c if (c.isalnum() or c in "-_") else "-" for c in str(session_id))


def session_dir(session_id):
    root = sessions_root()
    if root is None or not session_id:
        return None
    safe = sanitize(session_id)
    return root / safe if safe else None


def read_key(path):
    """One-line ticket file -> None (missing, empty or garbage: nobody has
    answered), the literal `none` (explicitly no ticket) or a validated key."""
    try:
        raw = Path(path).read_text(encoding="utf-8").strip()
    except Exception:
        return None
    if not raw:
        return None
    if raw.lower() == "none":
        return "none"
    raw = raw.upper()
    return raw if JIRA_KEY_RE.match(raw) else None


def read_text(path):
    try:
        return Path(path).read_text(encoding="utf-8").strip()
    except Exception:
        return ""


def write_text(path, text):
    try:
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        Path(path).write_text(text, encoding="utf-8")
    except Exception:
        pass


# --------------------------------------------------------------------------- #
# Git
# --------------------------------------------------------------------------- #

def git(cwd, *args):
    try:
        result = subprocess.run(
            ["git", "-C", cwd, *args],
            capture_output=True,
            text=True,
            timeout=GIT_TIMEOUT,
        )
    except Exception:
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def branch_key(cwd):
    """First `ABC-123`-shaped token in the branch name; empty when the branch
    has none or HEAD is detached."""
    match = BRANCH_KEY_RE.search(git(cwd, "branch", "--show-current") or "")
    return match.group(0) if match else ""


# --------------------------------------------------------------------------- #
# SessionStart: housekeeping
# --------------------------------------------------------------------------- #

def prune(root):
    """Remove session dirs whose owned files were all last touched more than
    PRUNE_AGE_S ago. Only names we could have created, never symlinks, only
    our two files; rmdir fails harmlessly if anything else is inside."""
    now = time.time()
    try:
        entries = list(os.scandir(root))[:PRUNE_CAP]
    except OSError:
        return
    for entry in entries:
        try:
            if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
                continue
            if not SAFE_NAME_RE.match(entry.name):
                continue
            newest = 0.0
            for name in OWNED_FILES:
                try:
                    newest = max(newest, os.lstat(os.path.join(entry.path, name)).st_mtime)
                except OSError:
                    pass
            if newest and now - newest < PRUNE_AGE_S:
                continue
            for name in OWNED_FILES:
                try:
                    os.unlink(os.path.join(entry.path, name))
                except OSError:
                    pass
            try:
                os.rmdir(entry.path)
            except OSError:
                pass
        except OSError:
            pass


def run_session_start():
    root = sessions_root()
    if root is not None:
        try:
            root.mkdir(parents=True, exist_ok=True)
        except OSError:
            pass
        prune(root)
    print("{}")


# --------------------------------------------------------------------------- #
# UserPromptSubmit: the question / the reminder
# --------------------------------------------------------------------------- #

PRIORITY = "TOP PRIORITY — handle this before anything else in this turn."
ASK = "Ask the user NOW — use the AskUserQuestion tool when available —"
BLOCK_RULES = (
    "Ask before you do anything else: no other tool call, no reading or searching "
    "files, no skill invocation, no plan or todo list, and no answer to any part of "
    "the request until the user has answered. Do not start the work and ask afterwards."
)


def write_rules(session_file):
    return (
        "Persist the answer to the session file {} — create its parent directories "
        "if needed — as exactly one line with no trailing newline: the chosen key "
        "uppercase (e.g. ABC-123), or the literal none. That file is what telemetry "
        "and the status line read for THIS session, and what stops this question "
        "from being asked again."
    ).format(json.dumps(str(session_file)))


def describe(key):
    return "none (working without a ticket)" if key == "none" else key


def ask_unset(bkey, session_file):
    """Nobody has answered in this session: ask, recommending the branch key
    when there is one, else no ticket."""
    options = []
    if bkey:
        options.append("'{} (from branch) (Recommended)'".format(bkey))
    options.append("'Another ticket id' (the user types it, e.g. ABC-123)")
    options.append("'No specific task'" if bkey else "'No specific task (Recommended if unsure)'")
    return "{} The Jira ticket for this session is not set. {} which Jira ticket this work belongs to. Options: {}. {} {}".format(
        PRIORITY, ASK, ", ".join(options), BLOCK_RULES, write_rules(session_file)
    )


def ask_branch_switch(bkey, session_key, session_file):
    """The branch changed since the last prompt and suggests a different key."""
    if session_key == "none":
        recorded = "this session records no specific task"
        current = "'No specific task (current setting)'"
    else:
        recorded = "this session records {}".format(session_key)
        current = "'Keep {} (current setting)'".format(session_key)
    return "{} The git branch changed: it now suggests {}, but {}. {} which applies. Options: '{} (from branch) (Recommended)', {}, 'Another ticket id' (the user types it). {} {}".format(
        PRIORITY, bkey, recorded, ASK, bkey, current, BLOCK_RULES, write_rules(session_file)
    )


def remind(session_key, session_file):
    """Resolved: a short reminder that keeps the topic-shift rule alive
    (it has to survive compaction, and only the model can spot a shift)."""
    return (
        "Jira ticket for this session: {}. If this prompt starts a different piece of "
        "work — another task, feature or bug — ask the user FIRST (AskUserQuestion) "
        "which ticket it belongs to, before acting on it, and update the session file "
        "{} with the answer (one line, uppercase key or none, no trailing newline). "
        "Tangents, follow-ups, questions and sub-tasks of the same work do not count "
        "as a shift."
    ).format(describe(session_key), json.dumps(str(session_file)))


def run_prompt(payload):
    session_id = payload.get("session_id")
    cwd = payload.get("cwd") or os.getcwd()
    if not session_id:
        return  # without a session there is nothing to attach the ticket to
    # Only inside a git work tree: a ticket only makes sense attached to a
    # project, and asking about Jira in home/Downloads/scratch dirs is noise.
    if git(cwd, "rev-parse", "--is-inside-work-tree") != "true":
        return

    sdir = session_dir(session_id)
    if sdir is None:
        return
    session_file = sdir / SESSION_FILE
    branch_file = sdir / BRANCH_FILE

    session_key = read_key(session_file)
    bkey = branch_key(cwd)
    prev_bkey = read_text(branch_file)

    if session_key is None:
        msg = ask_unset(bkey, session_file)
    elif bkey and bkey != session_key and bkey != prev_bkey:
        msg = ask_branch_switch(bkey, session_key, session_file)
    else:
        msg = remind(session_key, session_file)

    # Remember what the branch suggested (so the switch question fires once
    # per switch) and keep the live session out of the prune window.
    write_text(branch_file, bkey)
    if session_key is not None:
        try:
            os.utime(session_file, None)
        except OSError:
            pass

    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": msg,
        }
    }))


def main():
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
        if not isinstance(payload, dict):
            payload = {}
        if payload.get("hook_event_name") == "SessionStart":
            run_session_start()
        else:
            run_prompt(payload)
    except Exception:
        pass  # context enrichment must never break a session
    sys.exit(0)


if __name__ == "__main__":
    main()
